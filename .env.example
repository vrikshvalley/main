# Firebase (client)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server only): required for online payments.
# Firebase console > Project settings > Service accounts > Generate new private key.
# Either base64 of the whole JSON file:
FIREBASE_SERVICE_ACCOUNT_BASE64=
# ...or the two fields separately:
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Staff who may retry shipments / resend emails / book returns (comma-separated, verified emails)
ADMIN_EMAILS=

# Where new-order / needs-attention alert emails go (comma-separated). Defaults to ADMIN_EMAILS.
ORDER_ALERT_EMAILS=
# Public address of the staff area; used for the "Open order" link in alert emails.
ADMIN_URL=https://admin.vrikshvalley.com

# Razorpay (use rzp_test_ keys until go-live; key id is the same value in both id vars)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks > https://<domain>/api/webhooks/razorpay
# events: payment.captured, payment.failed, order.paid, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# Delhivery
DELHIVERY_API_KEY=
# Host only: https://staging-express.dlv.in (test) or https://track.delhivery.com (live)
DELHIVERY_BASE_URL=
DELHIVERY_CLIENT_NAME=
DELHIVERY_PICKUP_LOCATION=
DELHIVERY_SELLER_ADDRESS=
DELHIVERY_SELLER_PHONE=
DELHIVERY_SELLER_GSTIN=
DELHIVERY_RETURN_CITY=
DELHIVERY_RETURN_STATE=
# Required: webhook rejects all requests without it
DELHIVERY_WEBHOOK_SECRET=

NEXT_PUBLIC_SELLER_PINCODE=
NEXT_PUBLIC_SITE_URL=https://vrikshvalley.com

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=

# MSG91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_SENDER_NAME=
MSG91_SENDER_EMAIL=
MSG91_EMAIL_DOMAIN=
MSG91_SMS_ROUTE=
MSG91_WHATSAPP_NUMBER=

# Direct online payment (Razorpay checkout). Leave false until payments are approved;
# orders go through WhatsApp meanwhile.
NEXT_PUBLIC_ONLINE_PAYMENTS=false

# Developer test pages under /api/sample-order are off in production unless this is true
ENABLE_TEST_ROUTES=false

# Newsletter: Google Apps Script web app URL (see docs/newsletter-apps-script.gs) and its shared secret
NEWSLETTER_SHEET_URL=
NEWSLETTER_SECRET=
