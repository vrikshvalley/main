# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ================================
# Firebase Configuration
# ================================
# Get these from: https://console.firebase.google.com/ > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ================================
# Razorpay Payment Gateway
# ================================
# Get these from: https://dashboard.razorpay.com/app/keys
# Use test keys (rzp_test_*) for development, live keys (rzp_live_*) for production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx

# Webhook Secret from: https://dashboard.razorpay.com/app/webhooks
RAZORPAY_WEBHOOK_SECRET=

# ================================
# Delhivery Shipping
# ================================
# Get API token from Delhivery panel or contact support
DELHIVERY_API_KEY=
DELHIVERY_BASE_URL=https://track.delhivery.com/api
DELHIVERY_CLIENT_NAME=Vriksh Valley
DELHIVERY_PICKUP_LOCATION=Primary
DELHIVERY_SELLER_ADDRESS=
DELHIVERY_SELLER_PHONE=

# ================================
# Application Configuration
# ================================
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ================================
# Email Service (Optional)
# ================================
# For Gmail/Google Workspace SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@vrikshvalley.com
FROM_NAME=Vriksh Valley

# ================================
# MSG91 (Optional - for SMS/WhatsApp)
# ================================
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# ================================
# Development/Production Flag
# ================================
NODE_ENV=development
