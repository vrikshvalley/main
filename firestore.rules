rules_version = '2';

// Vriksh Valley: Firestore security rules.
// Deploy with:  firebase deploy --only firestore:rules   (or paste into Firebase console > Firestore > Rules)
//
// Orders, payments and stock are written ONLY by the server (Firebase Admin SDK,
// lib/server/orders.js), which bypasses these rules. Browsers can read their
// own orders but can never create or edit one, so nobody can mark an order
// "paid" from DevTools.
//
// Staff are Firebase users with the custom claim { admin: true }
// (set once with the Admin SDK: auth.setCustomUserClaims(uid, { admin: true })).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Catalogue: public read, staff write.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();

      // Customer reviews: signed-in users add their own validated rating; nobody edits others'.
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Profiles (addresses, wishlist): only the owner (and staff).
    match /profiles/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // Saved carts: only the owner.
    match /carts/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Orders: owner can read; nobody writes from a browser.
    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.user_id == request.auth.uid);
      allow write: if false;
    }

    // Stock holds and Plant Doctor slot locks are server-only (Firebase Admin): no browser access.
    // (reservations, plantDoctorSlots fall through to the default deny below.)

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
